---
//Internalization
import { getI18N } from '../i18n/'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class="mb-7">
  <h2 class="mb-2 text-2xl font-bold">{i18n.labels.label_language}</h2>
  <ul class="inline-flex flex-wrap gap-2">
    {i18n.languages.map(({ language, fluency }) => {
      return (
        <li class="px-2 py-1 text-sm truncate bg-white border-t border-b border-l border-r border-solid rounded rounded-r-md group-hover:bg-transparent group-hover:text-white dark:bg-color-black-extra dark:border-border-dark">
          <span>
            {language} - {fluency}
          </span>
        </li>
      )
    })}
  </ul>
</section>
