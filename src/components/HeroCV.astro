---
//Internalization
import { getI18N } from '../i18n/'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })

import Mail from '@/assets/Mail.astro'
import Phone from '@/assets/Phone.astro'
import LinkedIn from '@/assets/LinkedIn.astro'
import GitHub from '@/assets/GitHub.astro'
import Country from '@/assets/Country.astro'
import World from '@/assets/World.astro'
import Platzi from '@assets/Platzi.astro'

const { name, label, image, location, profiles, phone, email, url } = i18n.basics
const { city, region } = location

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
}
const linkedInfo = profiles.find(({ network }) => network === 'LinkedIn')
const linkedUrl = linkedInfo?.url

const printInfo = [email, phone, url].filter(Boolean).join(' • ')
---

<section>
  <div class="flex flex-col items-center justify-start gap-8 md:flex-row">
    <figure class="no-print">
      <img src={image} alt={name} class="object-cover w-32 rounded-full aspect-square" />
    </figure>

    <div class="flex flex-col items-center justify-center gap-2 pr-0 text-center md:items-start md:justify-start md:gap-1 md:pr-8">
      <h1 class="text-2xl">{name}</h1>
      <h2 class="text-base font-medium text-balance">{label}</h2>
      <p class="flex items-center gap-1">
        <Country />
        {city}, {region}
      </p>
      <footer class="print">
        <p>{printInfo}</p>
      </footer>
      <footer class="no-print">
        {url && (
          <a
            href={url}
            title={`${i18n.seo.title_link.normal} ${url}`}
            target="_self"
            rel="noopener noreferrer"
            class="border-t border-b border-l border-r border-solid hover:bg-color-light-extra dark:bg-color-black-extra dark:hover:bg-hover-dark dark:border-border-dark"
          >
            <World />
          </a>
        )}
        {email && (
          <a
            href={`mailto:${email}`}
            title={`${i18n.seo.title_link.mail} ${email}`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-t border-b border-l border-r border-solid hover:bg-color-light-extra dark:bg-color-black-extra dark:hover:bg-hover-dark dark:border-border-dark"
          >
            <Mail />
          </a>
        )}
        {phone && (
          <a
            href={`tel:${phone}`}
            title={`${i18n.seo.title_link.phone} ${phone}`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-t border-b border-l border-r border-solid hover:bg-color-light-extra dark:bg-color-black-extra dark:hover:bg-hover-dark dark:border-border-dark"
          >
            <Phone />
          </a>
        )}
        {profiles.map(({ network, url, username }) => {
          const Icon = SOCIAL_ICONS[network]

          return (
            <a
              href={url}
              title={`${i18n.seo.title_link.network} ${network}: ${url}`}
              target="_blank"
              rel="noopener noreferrer"
              class="border-t border-b border-l border-r border-solid hover:bg-color-light-extra dark:bg-color-black-extra dark:hover:bg-hover-dark dark:border-border-dark"
            >
              <Icon />
            </a>
          )
        })}
        <a
          href="https://platzi.com/p/maauricioyair/"
          title={`${i18n.seo.title_link.certificate} Platzi: https://platzi.com/p/maauricioyair/`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-t border-b border-l border-r border-solid hover:bg-color-light-extra dark:bg-color-black-extra dark:hover:bg-hover-dark dark:border-border-dark"
        >
          <Platzi />
        </a>
      </footer>
    </div>
  </div>
</section>

<style>
  footer {
    display: flex;
    gap: 4px;
    margin-top: 1px;
  }

  footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }
</style>
