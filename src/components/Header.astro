---
import { getI18N } from '../i18n/'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<header class="flex justify-center items-center mx-auto py-5 fixed top-0 w-full z-50">
  <nav
    id="main-navigation"
    aria-label="Main navigation"
    class="border dark:border-border-dark rounded-full px-3 py-1 flex flex-row items-center bg-color-light-extra/50 dark:bg-color-black-extra/50 backdrop-blur-2xl"
  >
    <a
      href="#proyectos"
      data-section="proyectos"
      class="nav-link rounded-full px-3 transition hover:bg-color-white-link dark:hover:bg-color-black-link"
    >
      {i18n.header.projects}
    </a>

    <a
      href="#herramientas"
      data-section="herramientas"
      class="nav-link rounded-full px-3 transition hover:bg-color-white-link dark:hover:bg-color-black-link"
    >
      {i18n.header.tools}
    </a>

    <a
      href="#sobre-mi"
      data-section="sobre-mi"
      class="nav-link rounded-full px-3 transition hover:bg-color-white-link dark:hover:bg-color-black-link"
    >
      {i18n.header.about}
    </a>
  </nav>
</header>

<script>
  const navigation = document.querySelector('#main-navigation')

  if (navigation) {
    const links = navigation.querySelectorAll<HTMLAnchorElement>('.nav-link')

    // Actualizar enlace activo
    const setActiveLink = (sectionId: string) => {
      links.forEach((link) => {
        const isActive = link.dataset.section === sectionId

        link.classList.toggle('bg-color-white-link', isActive)
        link.classList.toggle('dark:bg-color-black-link', isActive)

        if (isActive) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }

    // Detectar clic en los enlaces
    links.forEach((link) => {
      link.addEventListener('click', () => {
        const sectionId = link.dataset.section

        if (sectionId) {
          setActiveLink(sectionId)
        }
      })
    })

    // Obtener las secciones
    const sections = Array.from(links)
      .map((link) => {
        const id = link.dataset.section
        return id ? document.getElementById(id) : null
      })
      .filter((section): section is HTMLElement => section !== null)

    // Detectar sección visible mediante scroll
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleSections = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)

        if (visibleSections.length > 0) {
          setActiveLink(visibleSections[0].target.id)
        }
      },
      {
        rootMargin: '-20% 0px -65% 0px',
        threshold: 0,
      }
    )

    sections.forEach((section) => observer.observe(section))

    // Detectar sección inicial
    const initialHash = window.location.hash.slice(1)

    if (initialHash && sections.some((section) => section.id === initialHash)) {
      setActiveLink(initialHash)
    } else if (sections.length > 0) {
      const currentSection = sections.find((section) => {
        const rect = section.getBoundingClientRect()
        return rect.top <= window.innerHeight * 0.35 && rect.bottom > 0
      })

      if (currentSection) {
        setActiveLink(currentSection.id)
      }
    }
  }
</script>
