---
import Stack from '@assets/Stack.astro'
import Confetti from '@/assets/Confetti.astro'

//Internalization
import { getI18N } from '../i18n/'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class="mb-7">
  <h2 class="mb-2 text-2xl font-bold">{i18n.labels.label_experience}</h2>
  <ul class="flex flex-col gap-6">
    {i18n.work.map(
      ({ name, startDate, endDate, position, summary, highlights, url, badges, achievements }) => {
        const startFormatDate = new Date(startDate)
        const endFormatDate = new Date(endDate)

        const startmonth = startFormatDate.toLocaleString(currentLocale, { month: 'long' })
        const startYear = String(startFormatDate.getFullYear())

        const endMonth = endFormatDate.toLocaleString(currentLocale, { month: 'long' })
        const endYear = endDate != null ? String(endFormatDate.getFullYear()) : 'Actual'
        const years = `${startmonth} ${startYear} - ${endMonth} ${endYear}`

        return (
          <li class="pb-6 border-b dark:border-border-dark last:border-b-0 last:pb-0">
            <article>
              <header class="mb-2">
                <h3 class="flex flex-wrap text-lg font-semibold gap-x-2">
                  {position}
                  <span class="flex items-center text-xs">|</span>
                  {url ? (
                    <a
                      href={url}
                      title={`${i18n.seo.title_link.normal} ${url}`}
                      target="_blank"
                      class="hover:underline"
                      rel="nofollow noreferrer noopener"
                    >
                      {name}
                    </a>
                  ) : (
                    { name }
                  )}
                </h3>

                <div class="flex flex-wrap text-xs text-gray-500 gap-x-2">
                  <time class="text-right capitalize">{years}</time>
                  <span class="flex items-center text-[9px]">|</span>
                  {badges.map((badge) => (
                    <span>{badge}</span>
                  ))}
                </div>
              </header>

              <footer>
                <ul class="inline-block ml-6 leading-6 list-disc text-wrap">
                  {summary.map((summ) => (
                    <li>{summ}</li>
                  ))}
                </ul>
                {/* 
                {achievements && (
                  <div class="my-2">
                    <div class="flex items-center gap-3">
                      <figure class="no-print">
                        <Confetti />
                      </figure>
                      <div class="flex-1">
                        <p class="text-sm"> {achievements}</p>
                      </div>
                    </div>
                  </div>
                )}
                <div class="flex items-center gap-3">
                  <figure class="no-print">
                    <Stack />
                  </figure>
                  <div class="flex-1">
                    <ul class="inline-flex flex-wrap items-center gap-2">
                      {highlights.map((highlight) => (
                        <li class="px-2 py-1 text-xs truncate border-t border-b border-l border-r border-solid rounded group-hover:bg-transparent group-hover:text-white bg-color-light-extra dark:bg-color-black-extra">
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div> 
                */}
              </footer>
            </article>
          </li>
        )
      }
    )}
  </ul>
</section>

<style>
  /* footer ul li {
    margin-left: 24px;
    line-height: 1.5;
    text-wrap: pretty;
  } */

  footer span {
    margin: 0.5rem 0rem;
  }
</style>
