---
import Book from '@assets/Book.astro'

//Internalization
import { getI18N } from '../i18n/'

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section class="mb-7">
  <h2 class="mb-2 font-bold text-2xl">{i18n.labels.label_education}</h2>
  <ul class="flex flex-col gap-4">
    {i18n.education.map(({ institution, startDate, endDate, area, url, highlights }) => {
      const startFormatDate = new Date(startDate)
      const endFormatDate = new Date(endDate)

      const startmonth = startFormatDate.toLocaleString(currentLocale, { month: 'long' })
      const startYear = String(startFormatDate.getFullYear())

      const endMonth = endFormatDate.toLocaleString(currentLocale, { month: 'long' })
      const endYear = endDate != null ? String(endFormatDate.getFullYear()) : 'Actual'
      const years = `${startmonth} ${startYear} - ${endMonth} ${endYear}`

      return (
        <li>
          <article>
            <header class="mb-2">
              <h3 class="font-semibold text-lg flex flex-wrap gap-x-2">
                {area}
                <span>|</span>
                {url ? (
                  <a
                    href={url}
                    title={`${i18n.seo.title_link.normal} ${url}`}
                    target="_blank"
                    class="hover:underline"
                    rel="nofollow noreferrer noopener"
                  >
                    {institution}
                  </a>
                ) : (
                  { institution }
                )}
              </h3>

              <div class="text-gray-500 text-[0.85rem]">
                <time class="text-right capitalize">{years}</time>
              </div>
            </header>
            <footer>
              {/* <div class="flex items-center gap-3">
                    <figure class="no-print">
                      <Book />
                    </figure>
                    <div class="flex-1">
                      <ul class="inline-flex items-center gap-2 flex-wrap">  
                      {
                        highlights.map(highlight => 
                          <li class="truncate  border-r border-t border-l border-b border-solid group-hover:bg-transparent group-hover:text-white bg-color-light-extra dark:bg-color-black-extra px-2 py-1 text-xs rounded">
                          <span>{highlight}</span>
                          </li>
                        )
                      }
                      </ul> 
                    </div>
                  </div> */}
            </footer>
          </article>
        </li>
      )
    })}
  </ul>
</section>

<style>
  article header h3 span {
    align-items: center;
    display: flex;
    font-size: 0.8rem;
  }

  /* footer ul li {
    margin-left: 24px;
    line-height: 1.5;
    text-wrap: pretty;
  } */

  footer span {
    margin: 0.5rem 0rem;
  }
</style>
