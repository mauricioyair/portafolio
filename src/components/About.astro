---
//Internalization
import { getI18N } from "../i18n/"

const { currentLocale } = Astro
const i18n = getI18N({ currentLocale })
---

<section id="sobre-mi" data-section="sobre-mi" class="scroll-m-20">  
  <h2 class="flex items-center mb-6 text-3xl font-semibold gap-x-8">     
    {i18n.header.about}
  </h2>

  <h3 class="font-medium text-2xl">{i18n.labels.label_academic} 🎓</h3>
  <article class="flex flex-col items-center justify-center gap-8 md:flex-row"> 
    <div class="[&>p]:mb-4 text-pretty"> 
      <p set:html={i18n.about.summary_academic}></p>               
    </div>    
  </article> 

  <h3 class="font-medium text-2xl">{i18n.labels.label_professional} 👨🏻‍💻</h3>
  <article class="flex flex-col items-center justify-center gap-8 md:flex-row"> 
    <div class="[&>p]:mb-4 text-pretty"> 
      <p set:html={i18n.about.summary_professional}></p>               
    </div>    
  </article> 
</section>

<script>  
  import { annotate, annotationGroup } from 'rough-notation'

  const e1 = document.querySelector('.markHighlight');
  const e2 = document.querySelector('.markUnderline');
  const e3 = document.querySelector('.markBracket');

  const markHighlight = annotate(e1, { type: 'highlight', multiline: true });
  const markUnderline = annotate(e2, { type: 'underline', multiline: true } );
  const markBracket = annotate(e3, { type: 'bracket', brackets: ['left', 'right'] });

  const ag = annotationGroup([markUnderline, markBracket, markHighlight]);
  ag.show();
  
  var changeColor = [];
  changeColor.push(markHighlight, markUnderline, markBracket);
  changeColor.forEach((mark) => {
    mark.color = '#ff4500';
  });
</script>